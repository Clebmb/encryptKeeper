{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "encryptKeeper Professional",
  "version": "1.0.0",
  "identifier": "com.clebmbsoftware.encryptkeeper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "encryptKeeper Professional",
        "width": 1040,
        "height": 560,
        "minWidth": 1040,
        "minHeight": 520,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Codex",
    "shortDescription": "encryptKeeper Professional 1.0",
    "longDescription": "encryptKeeper Professional: an OpenPGP and S/MIME desktop workspace for notes, files, certificates, and hardware tokens.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      },
      "wix": {
        "language": ["en-US"]
      }
    }
  }
}
